---
import BuilderLayout from '../../layouts/BuilderLayout.astro';
---

<BuilderLayout
  title="Gratis website maken | Website Builder | Star Local"
  description="Maak gratis uw professionele website in ongeveer 5 minuten. Vul uw bedrijfsgegevens in en ons systeem bouwt automatisch uw website."
  canonical="/gratis-website/start/"
>
  <div class="container">
    <aside class="builder-beta-banner" role="status" aria-label="Bèta-informatie">
      <p class="builder-beta-banner__eyebrow">Star Local Website Builder Beta</p>
      <p class="builder-beta-banner__title">Welkom bij de Star Local Website Builder Beta.</p>
      <p class="builder-beta-banner__text">
        U kunt gratis uw website samenstellen.
        Tijdens de bèta wordt uw website nog niet automatisch gepubliceerd.
        Na controle zetten wij uw website gratis live.
      </p>
    </aside>
    <div id="website-builder-root" class="website-builder-root" aria-live="polite"></div>
    <noscript>
      <p class="builder-noscript">
        De Website Builder vereist JavaScript. Schakel JavaScript in om uw gratis website samen te stellen.
      </p>
    </noscript>
  </div>
</BuilderLayout>

<script is:inline>
  document.querySelectorAll('.builder-generating-overlay').forEach(function (element) {
    element.remove();
  });
  document.querySelectorAll('.tenant-lightbox').forEach(function (element) {
    element.hidden = true;
    element.setAttribute('aria-hidden', 'true');
  });
  document.body.style.overflow = '';
  document.body.style.pointerEvents = '';
  document.documentElement.style.overflow = '';
</script>

<script>
  import { initWebsiteBuilder } from '../../lib/builder/app';

  initWebsiteBuilder();
</script>
