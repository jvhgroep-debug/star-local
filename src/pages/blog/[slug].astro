---
import BlogPostPage from '../../views/BlogPostPage.astro';
import MunicipalBlogPostPage from '../../views/MunicipalBlogPostPage.astro';
import { blogPosts, getBlogPost } from '../../data/blog/posts';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { slug } = Astro.params;
const post = Astro.props.post ?? getBlogPost(slug!);

if (!post) {
  return Astro.redirect('/404');
}
---

{post.bodyHtml ? <MunicipalBlogPostPage post={post} /> : <BlogPostPage post={post} />}
