---
export const prerender = false;

import AuthLayout from '../layouts/AuthLayout.astro';
import { AUTH_ROUTES } from '../lib/auth/constants';

const email = Astro.url.searchParams.get('email')?.trim().toLowerCase() ?? '';
const emailSent = Astro.url.searchParams.get('emailSent') !== '0';
---

<AuthLayout
  title="Controleer uw e-mail | Star Local"
  description="We hebben een magic link naar uw e-mailadres gestuurd om in te loggen op uw Star Local dashboard."
  canonical="/check-email/"
>
  <section class="auth-card" aria-labelledby="check-email-title">
    <div class="auth-card__icon auth-card__icon--info" aria-hidden="true">📬</div>
    <h1 id="check-email-title">Controleer uw e-mail</h1>
    {email ? (
      <p>
        We hebben een inloglink gestuurd naar <span class="auth-email-highlight">{email}</span>.
        Klik op de link in de e-mail om uw dashboard te openen.
      </p>
    ) : (
      <p>We hebben een inloglink naar uw e-mailadres gestuurd. Klik op de link om uw dashboard te openen.</p>
    )}
    {!emailSent ? (
      <div class="auth-dev-panel" id="auth-dev-panel" hidden>
        <p class="auth-dev-panel__label">Lokale ontwikkelmodus</p>
        <p class="auth-dev-panel__text">
          E-mailverzending is lokaal niet actief. Gebruik onderstaande inloglink om uw dashboard te testen.
        </p>
        <a class="btn btn-primary auth-dev-panel__link" id="auth-dev-magic-link" href="#">Naar inloglink</a>
      </div>
    ) : null}
    <p class="auth-muted">De link is 30 minuten geldig en kan maar één keer gebruikt worden. Controleer ook uw spammap.</p>
    <div class="auth-actions">
      <a class="btn btn-secondary" href={AUTH_ROUTES.login}>Andere e-mail gebruiken</a>
    </div>
  </section>
</AuthLayout>

{!emailSent ? (
  <script>
    const DEV_MAGIC_KEY = 'starlocal-dev-magic-url';
    const panel = document.getElementById('auth-dev-panel');
    const link = document.getElementById('auth-dev-magic-link') as HTMLAnchorElement | null;
    const devMagicUrl = sessionStorage.getItem(DEV_MAGIC_KEY);

    if (panel && link && devMagicUrl) {
      link.href = devMagicUrl;
      panel.removeAttribute('hidden');
      sessionStorage.removeItem(DEV_MAGIC_KEY);
    }
  </script>
) : null}
