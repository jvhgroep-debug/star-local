---
import PortfolioDetailPage from '../../../views/PortfolioDetailPage.astro';
import { getPortfolioProjects } from '../../../data/portfolio';

export function getStaticPaths() {
  return getPortfolioProjects('en').map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---
<PortfolioDetailPage locale="en" project={project} />
