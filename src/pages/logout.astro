---
export const prerender = false;

import { AUTH_ROUTES, SESSION_COOKIE_NAME, destroySession, getSessionTokenFromRequest } from '../lib/auth';
import type { D1Database } from '../lib/db/d1';

const db = Astro.locals.runtime?.env?.DB as D1Database | undefined;
const sessionToken = getSessionTokenFromRequest(Astro.request);

if (db && sessionToken) {
  await destroySession(db, { sessionToken });
}

const secure = Astro.url.protocol === 'https:' || Astro.request.headers.get('x-forwarded-proto') === 'https';

Astro.cookies.delete(SESSION_COOKIE_NAME, {
  path: '/',
  httpOnly: true,
  sameSite: 'lax',
  secure,
});

return Astro.redirect(`${AUTH_ROUTES.login}?loggedOut=1`);
---
