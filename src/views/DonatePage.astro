---
import BaseLayout from '../layouts/BaseLayout.astro';
import DonationCard from '../components/DonationCard.astro';
import RecentDonations from '../components/RecentDonations.astro';
import { getActiveDonationCampaigns, getRecentDonationsForCampaign } from '../data/donations';

const campaigns = getActiveDonationCampaigns();
const recentDonations = getRecentDonationsForCampaign('johan-op-reis-camper');

const pageTitle = 'Help Johan op reis 🚐🇳🇱 | Star Local';
const pageDescription =
  'Steun onze camperreis door Nederland. Doneer aan Johan op reis en help ons onderweg te blijven.';
const canonical = '/doneren/';
---

<BaseLayout
  locale="nl"
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  fullWidth={true}
>
  <section class="donate-hero" aria-label="Johan op reis – Camperreis Nederland">
    <img
      src="/images/johan-op-reis-hero-breed.png"
      alt="Johan op reis – Camperreis Nederland"
      width="2400"
      height="720"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </section>

  <section class="section donate-section" aria-label="Actieve donatiecampagnes">
    <div class="container donate-grid">
      {campaigns.length > 0 ? (
        campaigns.map((campaign) => <DonationCard campaign={campaign} />)
      ) : (
        <p class="donate-empty">Er zijn momenteel geen actieve donatiecampagnes.</p>
      )}
    </div>
  </section>

  <RecentDonations donations={recentDonations} />

  <section class="section donate-thanks" aria-label="Bedankt voor je steun">
    <div class="container donate-thanks__inner">
      <h2>Bedankt voor je steun! ❤️🚐🇳🇱</h2>
      <p>Hartelijk bedankt voor je donatie.</p>
      <p>
        Met jouw bijdrage help je mee om onze camperreis door Nederland mogelijk te maken. Iedere donatie
        brengt ons weer een stukje dichter bij ons doel.
      </p>
      <p>
        We waarderen je steun enorm en hopen je straks mee te kunnen nemen op ons avontuur door Nederland!
      </p>
      <p class="donate-thanks__signoff">
        <strong>Met vriendelijke groetjes,<br />Johan op reis</strong>
      </p>
    </div>
  </section>

  <script async src="https://js.stripe.com/v3/buy-button.js"></script>
</BaseLayout>

<style>
  .donate-hero {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: clamp(180px, 32vw, 400px);
    background: #070a0f;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    line-height: 0;
  }

  .donate-hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 46%;
  }

  .donate-section {
    padding-top: 2.5rem;
  }

  .donate-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .donate-empty {
    text-align: center;
    color: var(--text-muted);
    margin: 0;
  }

  .donate-thanks {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .donate-thanks__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    padding: 2rem 1.5rem;
    background: rgba(205, 184, 128, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .donate-thanks__inner h2 {
    margin: 0 0 1.25rem;
    color: var(--gold);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    line-height: 1.35;
  }

  .donate-thanks__inner p {
    margin: 0 0 1rem;
    color: var(--text-muted);
    line-height: 1.75;
    font-size: 1rem;
  }

  .donate-thanks__signoff {
    margin-top: 1.5rem !important;
    margin-bottom: 0 !important;
    color: var(--text) !important;
  }

  .donate-thanks__signoff strong {
    color: var(--gold-light);
    font-weight: 700;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .donate-hero {
      height: clamp(150px, 40vw, 280px);
    }

    .donate-hero img {
      object-position: center 42%;
    }
  }

  @media (max-width: 600px) {
    .donate-hero {
      height: clamp(140px, 44vw, 240px);
    }

    .donate-section {
      padding-top: 1.75rem;
    }

    .donate-thanks {
      padding-bottom: 3rem;
    }

    .donate-thanks__inner {
      padding: 1.5rem 1.15rem;
    }
  }
</style>
