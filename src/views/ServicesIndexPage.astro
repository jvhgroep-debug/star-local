---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTASection from '../components/CTASection.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n';
import { route } from '../i18n/routes';
import { getServices } from '../data/services';
import { GRATIS_WEBSITE_SERVICE_CARD } from '../data/offers/gratis-website-service-card';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = useTranslations(locale);
const services = getServices(locale);
---

<BaseLayout
  locale={locale}
  title={dict.servicesPage.title}
  description={dict.servicesPage.description}
  canonical={route('services', locale)}
  hero={{
    title: dict.servicesPage.h1,
    intro: dict.servicesPage.intro,
  }}
>
  <section class="section">
    <div class="container">
      <div class="grid-3">
        <ServiceCard
          title={GRATIS_WEBSITE_SERVICE_CARD.title}
          description={GRATIS_WEBSITE_SERVICE_CARD.description}
          href={GRATIS_WEBSITE_SERVICE_CARD.href}
          image={GRATIS_WEBSITE_SERVICE_CARD.image}
          imageAlt={GRATIS_WEBSITE_SERVICE_CARD.imageAlt}
          learnMore={GRATIS_WEBSITE_SERVICE_CARD.ctaLabel}
        />
        {services.map((service) => (
          <ServiceCard
            title={service.h1}
            description={service.positioning}
            href={route('service', locale, { slug: service.slug })}
            image={service.image}
            imageAlt={service.imageAlt}
            learnMore={dict.buttons.learnMore}
          />
        ))}
      </div>
    </div>
  </section>

  <CTASection
    locale={locale}
    showFreeWebsite={true}
    title={dict.servicesPage.freeWebsiteCtaTitle}
    text={dict.servicesPage.freeWebsiteCtaText}
  />
</BaseLayout>
