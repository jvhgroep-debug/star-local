---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CTASection from '../components/CTASection.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n';
import { route } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={dict.approach.title}
  description={dict.approach.description}
  canonical={route('approach', locale)}
  hero={{
    title: dict.approach.h1,
    intro: dict.approach.intro,
  }}
>
  <section class="section">
    <div class="container">
      <ProcessSteps steps={dict.approach.steps} />
    </div>
  </section>

  <CTASection locale={locale} />
</BaseLayout>
