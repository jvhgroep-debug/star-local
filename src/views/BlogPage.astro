---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import CTASection from '../components/CTASection.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n';
import { route } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={dict.blog.title}
  description={dict.blog.description}
  canonical={route('blog', locale)}
  hero={{
    title: dict.blog.h1,
    intro: dict.blog.intro,
  }}
>
  <section class="section">
    <div class="container">
      <div class="categories" aria-label={dict.blog.h1}>
        {dict.blog.categories.map((cat) => <span class="category">{cat}</span>)}
      </div>
      <div class="grid-3">
        {dict.blog.posts.map((post) => (
          <BlogCard
            title={post.title}
            category={post.category}
            excerpt={post.excerpt}
            comingSoon={dict.blog.comingSoon}
          />
        ))}
      </div>
      <p class="note">{dict.blog.note}</p>
    </div>
  </section>

  <CTASection locale={locale} />
</BaseLayout>

<style>
  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .category {
    background: rgba(205, 184, 128, 0.08);
    border: 1px solid var(--border);
    color: var(--gold);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
  }

  .note {
    text-align: center;
    color: var(--text-soft);
    margin-top: 2rem;
    font-size: 0.95rem;
  }
</style>
