---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FAQSection from '../components/FAQSection.astro';
import { SITE } from '../data/site';
import { IMAGES } from '../data/images';
import {
  GRATIS_WEBSITE_AUTO_FEATURES,
  GRATIS_WEBSITE_BENEFITS,
  GRATIS_WEBSITE_FAQS,
  GRATIS_WEBSITE_INDUSTRIES,
  GRATIS_WEBSITE_PAGES,
  GRATIS_WEBSITE_STEPS,
} from '../data/offers/gratis-website';

const canonicalPath = '/gratis-website/';
const pageUrl = `${SITE.url}${canonicalPath}`;
const startHref = '/gratis-website/start/';

const seoTitle = 'Gratis professionele website maken in 3 minuten | Star Local';
const seoDescription =
  'Maak gratis een professionele website in 3 minuten. Geen technische kennis nodig. Vul uw gegevens in, kies uw stijl en ons systeem bouwt automatisch uw website.';

const steps = [...GRATIS_WEBSITE_STEPS];
const pages = [...GRATIS_WEBSITE_PAGES];
const benefits = [...GRATIS_WEBSITE_BENEFITS];
const autoFeatures = [...GRATIS_WEBSITE_AUTO_FEATURES];
const industries = [...GRATIS_WEBSITE_INDUSTRIES];
const faqs = GRATIS_WEBSITE_FAQS.map((faq) => ({ question: faq.question, answer: faq.answer }));

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seoTitle,
  description: seoDescription,
  url: pageUrl,
  inLanguage: 'nl-NL',
  isPartOf: {
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Gratis website builder',
  description:
    'Gratis een professionele website laten opbouwen in 3 minuten. Geen technische kennis nodig — ons systeem bouwt automatisch uw website.',
  provider: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    email: SITE.email,
    telephone: SITE.phoneRaw,
  },
  areaServed: {
    '@type': 'Country',
    name: 'Nederland',
  },
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'EUR',
    description: 'Gratis starten met het automatisch opbouwen van uw professionele website.',
    url: pageUrl,
    availability: 'https://schema.org/InStock',
  },
};

const schema = [webPageSchema, serviceSchema];
---

<BaseLayout
  locale="nl"
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalPath}
  image={IMAGES.heroHome}
  schema={schema}
  fullWidth
  hero={{
    title: 'Gratis professionele website',
    intro: 'Binnen 3 minuten online. Geen technische kennis nodig.',
    ariaLabel: 'Gratis professionele website maken',
    backgroundImage: IMAGES.serviceWebsiteDesign,
    ctas: [{ label: 'Start gratis', href: startHref, variant: 'primary' }],
    usps: ['Binnen 3 minuten', 'Geen technische kennis nodig', '5 pagina\'s inbegrepen', 'Direct zichtbaar resultaat'],
  }}
>
  <div class="container page-top">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Gratis website' },
      ]}
    />
  </div>

  <section class="section benefits-section" id="voordelen" aria-labelledby="benefits-title">
    <div class="container">
      <SectionHeading
        title="Waarom Star Local?"
        description="Alles wat u nodig heeft om professioneel online te gaan — zonder kosten en zonder gedoe."
      />
      <ul class="benefits-grid" aria-labelledby="benefits-title">
        {benefits.map((benefit) => (
          <li class="benefit-item">
            <span class="benefit-item__check" aria-hidden="true">✓</span>
            <span>{benefit}</span>
          </li>
        ))}
      </ul>
      <div class="section-cta">
        <a class="btn btn-primary" href={startHref}>Start gratis</a>
      </div>
    </div>
  </section>

  <section class="section alt-section" id="paginas" aria-labelledby="included-title">
    <div class="container">
      <SectionHeading
        title="5 pagina's inbegrepen"
        description="Uw website wordt compleet opgeleverd met alle essentiële pagina's die elke ondernemer nodig heeft."
      />

      <div class="pages-grid">
        {pages.map((page, index) => (
          <article class="page-card">
            <span class="page-card__number" aria-hidden="true">{index + 1}</span>
            <h3>{page.title}</h3>
            <p>{page.text}</p>
          </article>
        ))}
      </div>

      <div class="auto-features">
        <h3 id="auto-features-title">Daarnaast automatisch</h3>
        <ul class="check-list" aria-labelledby="auto-features-title">
          {autoFeatures.map((feature) => <li>{feature}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="hoe-werkt-het" aria-labelledby="how-it-works-title">
    <div class="container">
      <SectionHeading
        title="Hoe werkt het?"
        description="In drie eenvoudige stappen van idee naar professionele website."
      />
      <div class="steps-wrapper">
        <ProcessSteps steps={steps} />
      </div>
      <div class="section-cta">
        <a class="btn btn-primary" href={startHref}>Start gratis</a>
      </div>
    </div>
  </section>

  <section class="section alt-section" id="voor-wie" aria-labelledby="audience-title">
    <div class="container">
      <SectionHeading
        title="Voor wie?"
        description="Onze website builder is geschikt voor lokale ondernemers en dienstverleners in allerlei branches."
      />
      <div class="industry-grid">
        {industries.map((industry) => (
          <article class="industry-card">
            <h3>{industry.title}</h3>
            <p>{industry.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="voorbeeldwebsite" aria-labelledby="example-title">
    <div class="container">
      <SectionHeading
        title="Voorbeeldwebsite"
        description="Zo kan uw website eruitzien zodra u uw gegevens heeft ingevuld. Binnenkort kunt u hier een live voorbeeld bekijken."
      />
      <div class="example-placeholder" role="img" aria-label="Placeholder voorbeeldwebsite">
        <div class="example-placeholder__chrome">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="example-placeholder__body">
          <p class="example-placeholder__eyebrow">Voorbeeld</p>
          <p class="example-placeholder__title">Uw professionele bedrijfswebsite</p>
          <p class="example-placeholder__text">
            Hier verschijnt straks een interactief voorbeeld van de website die ons systeem voor u opbouwt.
          </p>
        </div>
      </div>
    </div>
  </section>

  <FAQSection title="Veelgestelde vragen" faqs={faqs} />

  <section class="section final-cta" id="start-gratis" aria-labelledby="final-cta-title">
    <div class="container">
      <div class="final-cta__inner">
        <h2 id="final-cta-title">Maak nu gratis uw website</h2>
        <p>
          Vul uw bedrijfsgegevens in, kies uw stijl en laat ons systeem binnen 3 minuten automatisch uw
          professionele website opbouwen.
        </p>
        <div class="final-cta__actions">
          <a class="btn btn-primary btn-lg" href={startHref}>Start gratis</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-top {
    padding-top: 1.25rem;
  }

  .alt-section {
    background: rgba(205, 184, 128, 0.03);
    border-block: 1px solid var(--border);
  }

  .section-cta {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .benefits-section {
    padding-top: 0.5rem;
  }

  .benefits-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .benefit-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.65rem;
    padding: 1.5rem 1rem;
    background: rgba(205, 184, 128, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.4;
    transition: transform var(--transition), border-color var(--transition);
  }

  .benefit-item:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .benefit-item__check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(37, 211, 102, 0.12);
    color: #25d366;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .pages-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .page-card {
    background: rgba(205, 184, 128, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.35rem 1.15rem;
    transition: transform var(--transition), border-color var(--transition);
  }

  .page-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .page-card__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: rgba(205, 184, 128, 0.15);
    color: var(--gold);
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .page-card h3 {
    color: var(--gold);
    margin: 0 0 0.65rem;
    font-size: 1.05rem;
  }

  .page-card p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.65;
    font-size: 0.92rem;
  }

  .steps-wrapper :global(.process-steps) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .industry-card {
    background: rgba(205, 184, 128, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.35rem;
    transition: transform var(--transition), border-color var(--transition);
  }

  .industry-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .industry-card h3 {
    color: var(--gold);
    margin: 0 0 0.65rem;
    font-size: 1.05rem;
  }

  .industry-card p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .auto-features {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(205, 184, 128, 0.04);
  }

  .auto-features h3 {
    color: var(--gold);
    margin: 0 0 0.65rem;
    font-size: 1.05rem;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem 1rem;
  }

  .check-list li {
    color: var(--text-muted);
    padding-left: 1.3rem;
    position: relative;
    line-height: 1.6;
  }

  .check-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--gold);
    font-weight: 700;
  }

  .industry-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .example-placeholder {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: #0a0e14;
    box-shadow: var(--shadow);
  }

  .example-placeholder__chrome {
    display: flex;
    gap: 0.45rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    background: rgba(205, 184, 128, 0.05);
  }

  .example-placeholder__chrome span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(205, 184, 128, 0.35);
  }

  .example-placeholder__body {
    min-height: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem 1.5rem;
    background:
      radial-gradient(circle at top, rgba(205, 184, 128, 0.12), transparent 55%),
      linear-gradient(180deg, rgba(7, 10, 15, 0.2), rgba(7, 10, 15, 0.85));
  }

  .example-placeholder__eyebrow {
    margin: 0 0 0.5rem;
    color: var(--gold);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .example-placeholder__title {
    margin: 0 0 0.75rem;
    color: var(--text);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 700;
  }

  .example-placeholder__text {
    margin: 0;
    max-width: 520px;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .final-cta {
    padding-bottom: 4rem;
  }

  .final-cta__inner {
    text-align: center;
    background: linear-gradient(135deg, rgba(205, 184, 128, 0.1), rgba(37, 211, 102, 0.06));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 3rem 2rem;
  }

  .final-cta__inner h2 {
    color: var(--gold);
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 3.5vw, 2.15rem);
  }

  .final-cta__inner p {
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 auto 2rem;
    line-height: 1.75;
    font-size: 1.05rem;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .btn-lg {
    padding: 0.95rem 2rem;
    font-size: 1.05rem;
  }

  @media (max-width: 1100px) {
    .benefits-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pages-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .steps-wrapper :global(.process-steps) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .benefits-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pages-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .industry-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .steps-wrapper :global(.process-steps) {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .benefits-grid,
    .pages-grid,
    .industry-grid {
      grid-template-columns: 1fr;
    }

    .final-cta__inner {
      padding: 2.25rem 1.25rem;
    }

    .btn-lg {
      width: 100%;
      text-align: center;
    }
  }
</style>
