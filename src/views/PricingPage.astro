---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n';
import { route } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={dict.pricing.title}
  description={dict.pricing.description}
  canonical={route('pricing', locale)}
>
  <PageHero title={dict.pricing.h1} subtitle={dict.pricing.intro} />
  <section class="section">
    <div class="container grid-3">
      {dict.pricing.tiers.map((tier) => (
        <article class="card">
          <div class="card-body">
            <h3>{tier.name}</h3>
            <p>{tier.description}</p>
            <ul>
              {tier.features.map((feature) => <li>{feature}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section alt">
    <div class="container content">
      <h2>{dict.pricing.factorsTitle}</h2>
      <ul>
        {dict.pricing.factors.map((factor) => <li>{factor}</li>)}
      </ul>
      <a href={route('contact', locale)} class="btn btn-primary">{dict.pricing.cta}</a>
    </div>
  </section>
  <CTASection locale={locale} />
</BaseLayout>

<style>
  h3 {
    color: var(--gold);
    margin-top: 0;
  }

  p,
  li {
    color: var(--text-muted);
    line-height: 1.7;
  }

  .alt {
    background: rgba(205, 184, 128, 0.03);
    border-block: 1px solid var(--border);
  }

  .content h2 {
    color: var(--gold);
  }
</style>
