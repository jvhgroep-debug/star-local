---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProjectsGrid from '../components/projects/ProjectsGrid.astro';
import CTASection from '../components/CTASection.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n';
import { route } from '../i18n/routes';
import { getProjects } from '../data/projects';
import { SITE } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = useTranslations(locale);
const page = dict.projectsPage;
const projects = getProjects();
const lang = locale === 'nl' ? 'nl' : 'en';

const whatsappProjectsUrl =
  'https://wa.me/31684002350?text=Hallo%20Star%20Local%2C%20ik%20heb%20jullie%20projecten%20bekeken%20en%20wil%20graag%20meer%20informatie.';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: page.h1,
  itemListElement: projects.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: project.name,
    url: project.website || `${SITE.url}${route('projects', locale)}`,
  })),
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: page.title,
  description: page.description,
  url: `${SITE.url}${route('projects', locale)}`,
  inLanguage: locale === 'nl' ? 'nl-NL' : 'en',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: dict.breadcrumbs.home, item: `${SITE.url}${route('home', locale)}` },
    { '@type': 'ListItem', position: 2, name: page.h1, item: `${SITE.url}${route('projects', locale)}` },
  ],
};
---

<BaseLayout
  locale={locale}
  title={page.title}
  description={page.description}
  canonical={route('projects', locale)}
  schema={[collectionSchema, itemListSchema, breadcrumbSchema]}
>
  <div class="container page-top">
    <Breadcrumbs items={[
      { label: dict.breadcrumbs.home, href: route('home', locale) },
      { label: page.h1 },
    ]} />
  </div>

  <section class="projects-hero section">
    <div class="container hero-inner">
      <p class="eyebrow">Star Local</p>
      <h1>{page.h1}</h1>
      <p class="lead">{page.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ProjectsGrid
        projects={projects}
        lang={lang}
        labels={{
          all: page.filters.all,
          website: page.filters.website,
          webshop: page.filters.webshop,
          seo: page.filters.seo,
          platform: page.filters.platform,
          viewWebsite: page.viewWebsite,
          placeholderNote: page.placeholderNote,
        }}
      />
    </div>
  </section>

  <CTASection
    locale={locale}
    title={page.cta.title}
    text={page.cta.text}
    whatsappUrl={whatsappProjectsUrl}
  />
</BaseLayout>

<style>
  .page-top {
    padding-top: 1.5rem;
  }

  .projects-hero {
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(205, 184, 128, 0.05), transparent);
  }

  .hero-inner {
    max-width: 760px;
  }

  h1 {
    color: var(--gold);
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .lead {
    color: var(--text-muted);
    font-size: 1.08rem;
    line-height: 1.75;
    margin: 0;
  }
</style>
