---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n';
import { route } from '../i18n/routes';
import { getServices } from '../data/services';
import { getPortfolioProjects } from '../data/portfolio';
import { getProjects } from '../data/projects';
import { getFooterLegal } from '../data/navigation';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = useTranslations(locale);

const services = getServices(locale);
const portfolioProjects = getPortfolioProjects(locale);
const linkProjects = getProjects();
const legalLinks = getFooterLegal(locale, dict);
---

<BaseLayout
  locale={locale}
  title={dict.sitemap.title}
  description={dict.sitemap.description}
  canonical={route('sitemap', locale)}
>
  <section class="section">
    <div class="container">
      <h1>{dict.sitemap.h1}</h1>
      <p class="intro">{dict.sitemap.intro}</p>

      <div class="sitemap-grid">
        <section>
          <h2>{dict.sitemap.main}</h2>
          <ul>
            <li><a href={route('home', locale)}>{dict.nav.home}</a></li>
            <li><a href={route('services', locale)}>{dict.nav.services}</a></li>
            <li><a href={route('projects', locale)}>{dict.nav.projects}</a></li>
            <li><a href={route('approach', locale)}>{dict.nav.approach}</a></li>
            <li><a href={route('about', locale)}>{dict.nav.about}</a></li>
            <li><a href={route('reviews', locale)}>{dict.reviews.h1}</a></li>
            <li><a href={route('pricing', locale)}>{dict.pricing.h1}</a></li>
            <li><a href={route('blog', locale)}>{dict.nav.blog}</a></li>
            <li><a href={route('contact', locale)}>{dict.nav.contact}</a></li>
          </ul>
        </section>

        <section>
          <h2>{dict.sitemap.services}</h2>
          <ul>
            {services.map((service) => (
              <li><a href={route('service', locale, { slug: service.slug })}>{service.h1}</a></li>
            ))}
          </ul>
        </section>

        <section>
          <h2>{dict.sitemap.projects}</h2>
          <ul>
            <li><a href={route('projects', locale)}>{dict.projectsPage.h1}</a></li>
            {linkProjects.map((project) => (
              <li>
                {project.website ? (
                  <a href={project.website} target="_blank" rel="noopener noreferrer">{project.name}</a>
                ) : (
                  <span>{project.name}</span>
                )}
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2>{dict.sitemap.portfolio}</h2>
          <ul>
            {portfolioProjects.map((project) => (
              <li><a href={route('portfolioItem', locale, { slug: project.slug })}>{project.name}</a></li>
            ))}
          </ul>
        </section>

        <section>
          <h2>{dict.sitemap.legal}</h2>
          <ul>
            {legalLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    color: var(--gold);
    margin: 0 0 0.5rem;
  }

  .intro {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  h2 {
    color: var(--gold);
    font-size: 1.1rem;
    margin: 0 0 0.75rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    margin-bottom: 0.4rem;
  }

  a {
    color: var(--text-muted);
  }

  a:hover {
    color: var(--gold);
  }

  @media (max-width: 700px) {
    .sitemap-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
