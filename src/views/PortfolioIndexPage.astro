---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectsGrid from '../components/projects/ProjectsGrid.astro';
import { getProjects } from '../data/projects';
import PortfolioCard from '../components/PortfolioCard.astro';
import CTASection from '../components/CTASection.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n';
import { route } from '../i18n/routes';
import { getPortfolioProjects } from '../data/portfolio';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = useTranslations(locale);
const projects = getProjects();
const legacyStories = getPortfolioProjects(locale).filter(story => !projects.some(project => project.slug === story.slug));
const page = dict.projectsPage;
---

<BaseLayout
  locale={locale}
  title={dict.portfolioPage.title}
  description={dict.portfolioPage.description}
  canonical={route('portfolio', locale)}
  hero={{
    title: dict.portfolioPage.h1,
    intro: dict.portfolioPage.intro,
  }}
>
  <section class="section">
    <div class="container">
      <ProjectsGrid
        projects={projects}
        lang={locale}
        labels={{ all: page.filters.all, website: page.filters.website, webshop: page.filters.webshop, seo: page.filters.seo, platform: page.filters.platform, viewWebsite: page.viewWebsite, placeholderNote: page.placeholderNote }}
      />
    </div>
  </section>

  {legacyStories.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>{locale === 'nl' ? 'Eerdere portfolioverhalen' : 'Earlier portfolio stories'}</h2>
        <p>{locale === 'nl' ? 'Meer voorbeelden van websites en online projecten uit ons portfolio.' : 'More examples of websites and online projects from our portfolio.'}</p>
        <div class="grid-3">
          {legacyStories.map(project => <PortfolioCard name={project.name} type={project.type} summary={project.summary} href={route('portfolioItem', locale, { slug: project.slug })} image={project.image} imageAlt={project.imageAlt} viewProject={dict.buttons.viewProject} />)}
        </div>
      </div>
    </section>
  )}

  <CTASection locale={locale} />
</BaseLayout>
