---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import CTASection from '../components/CTASection.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n';
import { route } from '../i18n/routes';
import { getPortfolioProjects } from '../data/portfolio';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = useTranslations(locale);
const projects = getPortfolioProjects(locale);
---

<BaseLayout
  locale={locale}
  title={dict.portfolioPage.title}
  description={dict.portfolioPage.description}
  canonical={route('portfolio', locale)}
  hero={{
    title: dict.portfolioPage.h1,
    intro: dict.portfolioPage.intro,
  }}
>
  <section class="section">
    <div class="container grid-3">
      {projects.map((project) => (
        <PortfolioCard
          name={project.name}
          type={project.type}
          summary={project.summary}
          href={route('portfolioItem', locale, { slug: project.slug })}
          image={project.image}
          imageAlt={project.imageAlt}
          viewProject={dict.buttons.viewProject}
        />
      ))}
    </div>
  </section>

  <CTASection locale={locale} />
</BaseLayout>
