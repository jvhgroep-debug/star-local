---
import type { Locale } from '../i18n/config';
import type { LegalPageContent } from '../data/legal/types';
import { SITE } from '../data/site';
import { route } from '../i18n/routes';
import { useTranslations } from '../i18n';

interface Props {
  locale: Locale;
  page: LegalPageContent;
}

const { locale, page } = Astro.props;
const dict = useTranslations(locale);
const contactHref = route('contact', locale);

const contactIntro =
  locale === 'nl'
    ? 'Contact: u kunt contact opnemen via het '
    : 'Contact: you can reach us via the ';

const contactFormLabel = locale === 'nl' ? 'contactformulier' : 'contact form';
const contactOr = locale === 'nl' ? ' of per e-mail via ' : ' or by email at ';
---

<section class="legal-page">
  <div class="legal-page__hero">
    <div class="container legal-page__hero-inner">
      <nav class="legal-breadcrumbs" aria-label="Breadcrumb">
        <a href={route('home', locale)}>{dict.breadcrumbs.home}</a>
        <span class="sep" aria-hidden="true">&gt;</span>
        <span aria-current="page">{page.breadcrumbLabel}</span>
      </nav>
      <h1>{page.title}</h1>
    </div>
  </div>

  <div class="container legal-page__body">
    <div class="legal-page__content">
      {page.notice && (
        <div class="legal-notice" role="note">
          <p>{page.notice}</p>
        </div>
      )}

      <p class="legal-intro">{page.intro}</p>

      <nav class="legal-toc" aria-label={page.tocLabel}>
        <h2 class="legal-toc__title">{page.tocLabel}</h2>
        <ol>
          {page.sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.title}</a>
            </li>
          ))}
        </ol>
      </nav>

      {page.sections.map((section) => (
        <article id={section.id} class="legal-section">
          <h2>{section.title}</h2>
          {section.blocks.map((block) => {
            if (block.type === 'p') {
              return <p>{block.text}</p>;
            }
            if (block.type === 'ul') {
              return (
                <ul>
                  {block.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              );
            }
            if (block.type === 'contact') {
              return (
                <p>
                  {contactIntro}
                  <a href={contactHref}>{contactFormLabel}</a>
                  {contactOr}
                  <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
                </p>
              );
            }
            return null;
          })}
        </article>
      ))}

      <p class="legal-updated">
        {locale === 'nl' ? 'Laatst bijgewerkt: ' : 'Last updated: '}
        {page.lastUpdated}
      </p>
    </div>
  </div>
</section>

<style>
  .legal-page {
    background: var(--bg, #060a10);
  }

  .legal-page__hero {
    border-bottom: 1px solid rgba(205, 184, 128, 0.25);
    padding: 1.75rem 0 2rem;
  }

  .legal-page__hero-inner {
    max-width: 820px;
  }

  .legal-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    margin-bottom: 1rem;
    color: var(--text-soft);
  }

  .legal-breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .legal-breadcrumbs a:hover {
    color: var(--gold);
  }

  .legal-breadcrumbs span[aria-current='page'] {
    color: var(--gold);
  }

  .sep {
    opacity: 0.55;
  }

  .legal-page__hero h1 {
    margin: 0;
    color: #cdb880;
    font-size: clamp(1.75rem, 4vw, 2.35rem);
    line-height: 1.2;
  }

  .legal-page__body {
    padding: 2.5rem 0 3rem;
  }

  .legal-page__content {
    max-width: 820px;
    margin: 0 auto;
  }

  .legal-notice {
    background: rgba(205, 184, 128, 0.08);
    border: 1px solid rgba(205, 184, 128, 0.35);
    border-radius: var(--radius-sm, 8px);
    padding: 1rem 1.15rem;
    margin-bottom: 1.75rem;
  }

  .legal-notice p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .legal-intro {
    color: var(--text-muted);
    line-height: 1.75;
    margin: 0 0 2rem;
    font-size: 1.02rem;
  }

  .legal-toc {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 8px);
    padding: 1.25rem 1.35rem;
    margin-bottom: 2.5rem;
  }

  .legal-toc__title {
    margin: 0 0 0.85rem;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .legal-toc ol {
    margin: 0;
    padding-left: 1.15rem;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .legal-toc a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .legal-toc a:hover {
    color: var(--gold);
  }

  .legal-section {
    scroll-margin-top: 120px;
  }

  .legal-section h2 {
    color: var(--gold);
    font-size: 1.15rem;
    margin: 2.25rem 0 0.85rem;
    line-height: 1.35;
  }

  .legal-section p,
  .legal-section li {
    color: var(--text-muted);
    line-height: 1.75;
    font-size: 0.98rem;
  }

  .legal-section p {
    margin: 0 0 1rem;
  }

  .legal-section ul {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }

  .legal-section li {
    margin-bottom: 0.4rem;
  }

  .legal-section a {
    color: var(--gold);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .legal-section a:hover {
    opacity: 0.85;
  }

  .legal-updated {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .legal-page__hero {
      padding: 1.25rem 0 1.5rem;
    }

    .legal-page__body {
      padding: 2rem 0 2.5rem;
    }
  }
</style>
