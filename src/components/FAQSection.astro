---
import type { FAQ } from '../data/services';

interface Props {
  title: string;
  faqs: FAQ[];
}

const { title, faqs } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<section class="faq-section section" aria-labelledby="faq-heading">
  <div class="container">
    <h2 id="faq-heading">{title}</h2>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>{faq.question}</summary>
          <div class="faq-answer">
            {faq.answer.split('\n\n').map((block) => (
              <p>
                {block.split('\n').map((line, index) => (
                  <>
                    {index > 0 && <br />}
                    {line}
                  </>
                ))}
              </p>
            ))}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  h2 {
    color: var(--gold);
    text-align: center;
    margin: 0 0 2rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .faq-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .faq-item {
    background: rgba(205, 184, 128, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.25rem 1rem;
  }

  summary {
    cursor: pointer;
    color: var(--text);
    font-weight: 600;
    padding: 0.85rem 0;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-answer p {
    color: var(--text-muted);
    margin: 0 0 1rem;
    line-height: 1.7;
  }

  .faq-answer p:last-child {
    margin-bottom: 0;
  }
</style>
