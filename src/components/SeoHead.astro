---
import { SITE, canonical } from '../data/site';
import type { Locale } from '../i18n/config';
import { localeLabels, locales } from '../i18n/config';
import { equivalentPath } from '../i18n/routes';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  robots?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  locale,
  title,
  description = SITE.defaultDescription,
  canonicalPath = '/',
  image = SITE.ogImage,
  robots = 'index, follow',
  schema,
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical(canonicalPath);
const requestedImage = image.startsWith('http') ? image : `${SITE.url}${image}`;
// Link-preview crawlers need a raster image rather than the site's SVG illustrations.
const ogImage = /\.svg(?:[?#]|$)/i.test(requestedImage) ? `${SITE.url}${SITE.ogImage}` : requestedImage;
const isDefaultShareImage = ogImage === `${SITE.url}${SITE.ogImage}`;
const imageType = /\.png(?:[?#]|$)/i.test(ogImage) ? 'image/png' : /\.jpe?g(?:[?#]|$)/i.test(ogImage) ? 'image/jpeg' : /\.webp(?:[?#]|$)/i.test(ogImage) ? 'image/webp' : undefined;
const { ogLocale, hreflang } = localeLabels[locale];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}${SITE.logo}`,
  email: SITE.email,
  telephone: SITE.phoneRaw,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: locales.map((l) => localeLabels[l].hreflang),
};

const schemas = [organizationSchema, websiteSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];

const hreflangLinks = noindex ? [] : locales.flatMap((l) => {
  const equivalent = equivalentPath(canonicalPath, l);
  return equivalent ? [{ hreflang: localeLabels[l].hreflang, href: canonical(equivalent) }] : [];
});
const hasTranslations = hreflangLinks.length > 1;
const defaultPath = equivalentPath(canonicalPath, 'nl');
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : robots} />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
<link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
<link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

{hasTranslations && hreflangLinks.map((link) => (
  <link rel="alternate" hreflang={link.hreflang} href={link.href} />
))}
{hasTranslations && defaultPath && <link rel="alternate" hreflang="x-default" href={canonical(defaultPath)} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
{imageType && <meta property="og:image:type" content={imageType} />}
{isDefaultShareImage && <><meta property="og:image:width" content="1889" /><meta property="og:image:height" content="863" /></>}
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={ogLocale} />
{locales.filter((l) => l !== locale).map((l) => (
  <meta property="og:locale:alternate" content={localeLabels[l].ogLocale} />
))}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

<script type="application/ld+json" set:html={JSON.stringify(schemas)} />
