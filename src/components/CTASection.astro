---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n';
import { route } from '../i18n/routes';
import { SITE } from '../data/site';

interface Props {
  locale: Locale;
  title?: string;
  text?: string;
  showWhatsapp?: boolean;
  whatsappUrl?: string;
  consultationHref?: string;
}

const {
  locale,
  title,
  text,
  showWhatsapp = true,
  whatsappUrl = SITE.whatsappUrl,
  consultationHref,
} = Astro.props;

const dict = useTranslations(locale);
const primaryHref = consultationHref ?? route('contact', locale);
---

<section class="cta-section" aria-labelledby="cta-section-title">
  <div class="container cta-inner">
    <h2 id="cta-section-title">{title ?? dict.cta.title}</h2>
    <p>{text ?? dict.cta.text}</p>
    <div class="cta-actions">
      <a href={primaryHref} class="btn btn-primary">{dict.buttons.freeConsultation}</a>
      {showWhatsapp && (
        <a href={whatsappUrl} class="btn btn-whatsapp" target="_blank" rel="noopener noreferrer">
          {dict.buttons.whatsappDirect}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 4rem 0;
  }

  .cta-inner {
    text-align: center;
    background: linear-gradient(135deg, rgba(205, 184, 128, 0.08), rgba(37, 211, 102, 0.05));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 3rem 2rem;
  }

  h2 {
    color: var(--gold);
    margin: 0 0 1rem;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  p {
    color: var(--text-muted);
    max-width: 640px;
    margin: 0 auto 2rem;
    line-height: 1.75;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
</style>
