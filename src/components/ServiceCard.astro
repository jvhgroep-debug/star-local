---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
  imageAlt?: string;
  learnMore: string;
}

const { title, description, href, image, imageAlt = '', learnMore } = Astro.props;
---

<article class="service-card card">
  {image && (
    <div class="service-card__image">
      <img src={image} alt={imageAlt} width="1200" height="800" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="card-body">
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <a href={href} class="card-link">{learnMore}</a>
  </div>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--transition), border-color var(--transition);
  }

  .service-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
  }

  .service-card__image {
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #0a0e14;
    border-bottom: 1px solid rgba(205, 184, 128, 0.3);
  }

  .service-card__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  h3 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
  }

  h3 a {
    color: var(--gold);
    text-decoration: none;
  }

  p {
    color: var(--text-muted);
    margin: 0 0 1rem;
    line-height: 1.65;
    flex: 1;
  }

  .card-link {
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }
</style>
