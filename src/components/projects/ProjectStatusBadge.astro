---
import type { ProjectStatus } from '../../data/projects';

interface Props {
  status: ProjectStatus;
  lang: 'nl' | 'en';
}

const { status, lang } = Astro.props;

const labels = {
  live: { nl: 'Live', en: 'Live' },
  development: { nl: 'In ontwikkeling', en: 'In development' },
  preview: { nl: 'Preview', en: 'Preview' },
};
---

<span class:list={['status-badge', `status-badge--${status}`]}>
  {labels[status][lang]}
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid var(--border);
  }

  .status-badge--live {
    color: #86efac;
    background: rgba(34, 197, 94, 0.12);
    border-color: rgba(34, 197, 94, 0.35);
  }

  .status-badge--development {
    color: var(--gold);
    background: rgba(205, 184, 128, 0.12);
    border-color: rgba(205, 184, 128, 0.35);
  }

  .status-badge--preview {
    color: #93c5fd;
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.35);
  }
</style>
