---
import type { GemeenteBenefitIcon } from '../../data/gemeentes/types';

interface Props {
  icon: GemeenteBenefitIcon;
}

const { icon } = Astro.props;
---

<span class="benefit-icon" aria-hidden="true">
  {
    icon === 'speed' && (
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M13 2L4 14h7l-1 8 10-14h-7l0-6z" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    icon === 'design' && (
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="3" y="4" width="18" height="14" rx="2" />
        <path d="M8 20h8" stroke-linecap="round" />
      </svg>
    )
  }
  {
    icon === 'seo' && (
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="11" cy="11" r="7" />
        <path d="M20 20l-3.5-3.5" stroke-linecap="round" />
        <path d="M8 11h6M11 8v6" stroke-linecap="round" />
      </svg>
    )
  }
  {
    icon === 'mobile' && (
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="7" y="2" width="10" height="20" rx="2" />
        <path d="M11 18h2" stroke-linecap="round" />
      </svg>
    )
  }
  {
    icon === 'communication' && (
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M21 12a8 8 0 01-8 8H7l-4 3V12a8 8 0 018-8h2a8 8 0 018 8z" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    icon === 'scale' && (
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M4 18V6M20 18V6M4 12h16" stroke-linecap="round" />
        <path d="M8 6v12M16 6v12" stroke-linecap="round" />
      </svg>
    )
  }
  {
    icon === 'custom' && (
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M12 3l2.2 6.8H21l-5.5 4 2.1 6.7L12 16.5 6.4 20.5l2.1-6.7L3 9.8h6.8L12 3z" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    icon === 'growth' && (
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M4 18V6M20 18V10M20 18H4" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M8 14l3-3 3 2 4-5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
</span>

<style>
  .benefit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-sm);
    background: rgba(205, 184, 128, 0.1);
    border: 1px solid var(--border);
    color: var(--gold);
  }
</style>
