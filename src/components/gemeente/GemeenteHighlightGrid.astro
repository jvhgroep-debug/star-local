---
import GemeenteBenefitIcon from './GemeenteBenefitIcon.astro';
import type { GemeenteBenefit } from '../../data/gemeentes/types';

interface Props {
  items: GemeenteBenefit[];
}

const { items } = Astro.props;
---

<ul class="highlight-grid">
  {
    items.map((item) => (
      <li class="highlight-card">
        <GemeenteBenefitIcon icon={item.icon} />
        <div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .highlight-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 820px;
    margin-inline: auto;
  }

  .highlight-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: rgba(205, 184, 128, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.15rem 1.25rem;
  }

  .highlight-card h3 {
    color: var(--gold);
    font-size: 1rem;
    margin: 0 0 0.25rem;
    line-height: 1.3;
  }

  .highlight-card p {
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
    font-size: 0.94rem;
  }
</style>
