---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = useTranslations(locale);
const form = dict.form;
---

<form class="contact-form" id="contactformulier" novalidate>
  <div class="form-status" id="form-status" role="status" aria-live="polite" hidden></div>

  <div class="field honeypot" aria-hidden="true">
    <label for="website">Website</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="form-row">
    <div class="field">
      <label for="naam">{form.name}</label>
      <input type="text" id="naam" name="naam" required autocomplete="name" />
      <span class="error" data-error-for="naam"></span>
    </div>
    <div class="field">
      <label for="bedrijfsnaam">{form.company}</label>
      <input type="text" id="bedrijfsnaam" name="bedrijfsnaam" autocomplete="organization" />
    </div>
  </div>

  <div class="form-row">
    <div class="field">
      <label for="email">{form.email}</label>
      <input type="email" id="email" name="email" required autocomplete="email" />
      <span class="error" data-error-for="email"></span>
    </div>
    <div class="field">
      <label for="telefoon">{form.phone}</label>
      <input type="tel" id="telefoon" name="telefoon" autocomplete="tel" />
    </div>
  </div>

  <div class="field">
    <label for="onderwerp">{form.subject}</label>
    <select id="onderwerp" name="onderwerp" required>
      <option value="">{form.chooseSubject}</option>
      {form.subjects.map((subject) => <option>{subject}</option>)}
    </select>
    <span class="error" data-error-for="onderwerp"></span>
  </div>

  <div class="field">
    <label for="bericht">{form.message}</label>
    <textarea id="bericht" name="bericht" rows="6" required></textarea>
    <span class="error" data-error-for="bericht"></span>
  </div>

  <div class="field checkbox">
    <label>
      <input type="checkbox" id="privacy" name="privacy" required />
      {form.privacy}
    </label>
    <span class="error" data-error-for="privacy"></span>
  </div>

  <button type="submit" class="btn btn-primary" id="contact-submit">{dict.buttons.sendMessage}</button>
</form>

<script define:vars={{ errors: form.errors, successMessage: form.successMessage, submitError: form.submitError, sending: form.sending }}>
  const formEl = document.getElementById('contactformulier');
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('contact-submit');

  function setStatus(message, type) {
    if (!statusEl) return;
    statusEl.hidden = !message;
    statusEl.textContent = message;
    statusEl.className = `form-status form-status--${type}`;
  }

  function clearFieldErrors() {
    document.querySelectorAll('[data-error-for]').forEach((el) => {
      el.textContent = '';
    });
  }

  function validateForm() {
    let valid = true;
    clearFieldErrors();

    const fields = [
      { id: 'naam', message: errors.name },
      { id: 'email', message: errors.email },
      { id: 'onderwerp', message: errors.subject },
      { id: 'bericht', message: errors.message },
      { id: 'privacy', message: errors.privacy },
    ];

    fields.forEach(({ id, message }) => {
      const input = document.getElementById(id);
      const error = document.querySelector(`[data-error-for="${id}"]`);
      let fieldValid = true;

      if (!input) return;

      if (input.type === 'checkbox') {
        fieldValid = input.checked;
      } else if (input.type === 'email') {
        fieldValid = input.value.trim() !== '' && input.value.includes('@');
      } else {
        fieldValid = input.value.trim() !== '';
      }

      if (error) error.textContent = fieldValid ? '' : message;
      if (!fieldValid) valid = false;
    });

    return valid;
  }

  function prefillSubjectFromQuery() {
    const params = new URLSearchParams(window.location.search);
    const subject = params.get('onderwerp');
    const select = document.getElementById('onderwerp');
    if (!subject || !select) return;

    const options = Array.from(select.options);
    const match = options.find((option) => option.value === subject || option.text === subject);
    if (match) select.value = match.value;
  }

  prefillSubjectFromQuery();

  formEl?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setStatus('', 'info');

    if (!validateForm()) return;

    const originalLabel = submitBtn?.textContent ?? '';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = sending;
    }

    const payload = {
      naam: document.getElementById('naam')?.value.trim() ?? '',
      bedrijfsnaam: document.getElementById('bedrijfsnaam')?.value.trim() ?? '',
      email: document.getElementById('email')?.value.trim() ?? '',
      telefoon: document.getElementById('telefoon')?.value.trim() ?? '',
      onderwerp: document.getElementById('onderwerp')?.value.trim() ?? '',
      bericht: document.getElementById('bericht')?.value.trim() ?? '',
      privacy: document.getElementById('privacy')?.checked ?? false,
      website: document.getElementById('website')?.value.trim() ?? '',
    };

    try {
      const response = await fetch('/api/contact/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (response.ok) {
        formEl.reset();
        setStatus(successMessage, 'success');
        return;
      }

      setStatus(submitError, 'error');
    } catch {
      setStatus(submitError, 'error');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    }
  });
</script>

<style>
  .contact-form {
    scroll-margin-top: 120px;
    background: rgba(205, 184, 128, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
  }

  .form-status {
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    font-size: 0.95rem;
    margin: 0 0 1.5rem;
  }

  .form-status--success {
    background: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.35);
    color: #bbf7d0;
  }

  .form-status--error {
    background: rgba(248, 113, 113, 0.12);
    border: 1px solid rgba(248, 113, 113, 0.35);
    color: #fecaca;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field {
    margin-bottom: 1rem;
  }

  label {
    display: block;
    color: var(--gold);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 1rem;
  }

  .checkbox label {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--text-muted);
    font-weight: 400;
  }

  .checkbox input {
    width: auto;
    margin-top: 0.2rem;
  }

  .error {
    display: block;
    color: #f87171;
    font-size: 0.82rem;
    margin-top: 0.35rem;
    min-height: 1rem;
  }

  @media (max-width: 700px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
