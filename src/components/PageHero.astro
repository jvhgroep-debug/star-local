---
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  fullWidth?: boolean;
  loading?: 'eager' | 'lazy';
}

const {
  title,
  subtitle,
  image,
  imageAlt = '',
  fullWidth = false,
  loading = 'eager',
} = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--image': !!image, 'page-hero--full': fullWidth }]} style={image ? `--hero-image: url(${image})` : undefined}>
  {image && <div class="page-hero-overlay" aria-hidden="true"></div>}
  <div class="container page-hero-inner">
    <div class="page-hero-copy">
      <slot name="eyebrow" />
      <h1>{title}</h1>
      {subtitle && <p class="page-hero-subtitle">{subtitle}</p>}
      <slot />
    </div>
    {image && !fullWidth && (
      <div class="page-hero-media">
        <img src={image} alt={imageAlt} width="800" height="500" loading={loading} decoding="async" />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    padding: 3rem 0;
    border-bottom: 1px solid var(--border);
  }

  .page-hero--full {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    min-height: 420px;
    display: flex;
    align-items: center;
    background-color: var(--bg);
    background-image: var(--hero-image);
    background-size: cover;
    background-position: center right;
    padding: 4rem 0;
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 14, 20, 0.92) 0%, rgba(10, 14, 20, 0.55) 55%, rgba(10, 14, 20, 0.2) 100%);
  }

  .page-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2rem;
    align-items: center;
  }

  .page-hero--full .page-hero-inner {
    grid-template-columns: 1fr;
  }

  h1 {
    color: var(--gold);
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .page-hero-subtitle {
    color: var(--text-muted);
    font-size: 1.08rem;
    line-height: 1.75;
    max-width: 640px;
    margin: 0;
  }

  .page-hero-media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  @media (max-width: 900px) {
    .page-hero-inner {
      grid-template-columns: 1fr;
    }

    .page-hero--full {
      background-position: 75% center;
      min-height: 360px;
    }
  }
</style>
