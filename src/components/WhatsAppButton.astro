---
import { SITE } from '../data/site';
const en = Astro.url.pathname.startsWith('/en/');
const copy = en ? {
 title: 'How can we help you?', intro: 'Answer a few short questions and continue in WhatsApp.', topic: 'What do you need?', options: ['A new website', 'A webshop', 'SEO / Google visibility', 'Website maintenance', 'Other question'], company: 'Company name', website: 'Your website (optional)', message: 'Your question', send: 'Continue in WhatsApp', close: 'Close', label: 'Contact Star Local on WhatsApp', greeting: 'Hello Star Local, I have an enquiry via www.starlocal.nl.', page: 'Page', name: 'Company', interest: 'Interested in', question: 'Question'
} : {
 title: 'Waar kunnen we je mee helpen?', intro: 'Beantwoord een paar korte vragen en ga verder in WhatsApp.', topic: 'Waar heb je interesse in?', options: ['Website laten maken', 'Webshop laten maken', 'SEO / beter gevonden worden', 'Websiteonderhoud', 'Andere vraag'], company: 'Bedrijfsnaam', website: 'Je website (optioneel)', message: 'Je vraag', send: 'Verder in WhatsApp', close: 'Sluiten', label: 'Neem contact op met Star Local via WhatsApp', greeting: 'Hallo Star Local, ik heb een aanvraag via www.starlocal.nl.', page: 'Pagina', name: 'Bedrijf', interest: 'Interesse in', question: 'Vraag'
};
---
<a href={SITE.whatsappUrl} class="whatsapp-float" data-wa-open aria-label={copy.label} aria-haspopup="dialog">
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.881 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
</a>
<dialog class="wa-dialog" aria-labelledby="wa-title" data-wa-dialog>
  <div class="wa-heading"><h2 id="wa-title">{copy.title}</h2><button type="button" data-wa-close aria-label={copy.close}>×</button></div>
  <p>{copy.intro}</p>
  <form data-wa-form data-number={SITE.phoneRaw.replace(/\D/g, '')} data-copy={JSON.stringify(copy)}>
    <label>{copy.topic}<select name="topic" required>{copy.options.map(option => <option value={option}>{option}</option>)}</select></label>
    <label>{copy.company}<input name="company" autocomplete="organization" maxlength="120" required /></label>
    <label>{copy.website}<input name="website" inputmode="url" maxlength="200" placeholder="www.example.com" /></label>
    <label>{copy.message}<textarea name="question" rows="3" maxlength="1500" required></textarea></label>
    <button class="wa-send" type="submit">{copy.send} ↗</button>
  </form>
</dialog>
<script>
function setupWhatsApp() {
 const trigger = document.querySelector<HTMLAnchorElement>('[data-wa-open]');
 const dialog = document.querySelector<HTMLDialogElement>('[data-wa-dialog]');
 const form = document.querySelector<HTMLFormElement>('[data-wa-form]');
 if (!trigger || !dialog || !form || trigger.dataset.ready) return;
 trigger.dataset.ready = 'true';
 trigger.addEventListener('click', event => { event.preventDefault(); dialog.showModal(); });
 dialog.querySelector('[data-wa-close]')?.addEventListener('click', () => dialog.close());
 dialog.addEventListener('click', event => { if(event.target === dialog) { const r=dialog.getBoundingClientRect(); if(event.clientX<r.left || event.clientX>r.right || event.clientY<r.top || event.clientY>r.bottom) dialog.close(); } });
 dialog.addEventListener('close', () => trigger.focus());
 form.addEventListener('submit', event => {
  event.preventDefault();
  if(!form.reportValidity()) return;
  const data = new FormData(form); const c = JSON.parse(form.dataset.copy || '{}');
  const lines = [c.greeting, '', c.interest + ': ' + data.get('topic'), c.name + ': ' + String(data.get('company') || '').trim()];
  const website = String(data.get('website') || '').trim();
  if (website) lines.push('Website: ' + website);
  lines.push(c.question + ': ' + String(data.get('question') || '').trim(), c.page + ': https://www.starlocal.nl' + location.pathname);
  const url = 'https://wa.me/' + form.dataset.number + '?text=' + encodeURIComponent(lines.join('\n'));
  window.location.assign(url);
 });
}
setupWhatsApp();
document.addEventListener('astro:page-load', setupWhatsApp);
</script>
<style>
.whatsapp-float{position:fixed;right:1.25rem;bottom:1.25rem;z-index:90;width:58px;height:58px;border-radius:50%;background:#128c4b;color:white;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px #128c4b55;transition:transform .2s}
.whatsapp-float:hover{transform:translateY(-3px)}
.whatsapp-float:focus-visible,.wa-dialog :focus-visible{outline:3px solid #1960db;outline-offset:3px}
.wa-dialog{position:fixed;inset:auto 20px 90px auto;margin:0;width:min(420px,calc(100vw - 32px));max-height:calc(100dvh - 110px);overflow:auto;padding:24px;border:1px solid #dae5e0;border-radius:20px;background:white;color:#172d26;box-shadow:0 20px 70px #0004;font-family:inherit}
.wa-dialog::backdrop{background:#071a264d}.wa-heading{display:flex;align-items:flex-start;gap:15px;justify-content:space-between}.wa-heading h2{font-size:22px;line-height:1.3;margin:0}.wa-heading button{background:#eef5f1;border:0;border-radius:50%;font-size:25px;cursor:pointer;width:34px;height:34px;flex-shrink:0}.wa-dialog p{font-size:14px;line-height:1.5;color:#576a61;margin:12px 0 20px}.wa-dialog label{display:block;font-size:14px;font-weight:600;margin:13px 0}.wa-dialog input,.wa-dialog select,.wa-dialog textarea{box-sizing:border-box;display:block;width:100%;margin-top:6px;padding:11px 12px;border:1px solid #bdcfc6;border-radius:8px;font:inherit;font-size:16px;color:#18372a;background:white}.wa-dialog textarea{resize:vertical}.wa-send{width:100%;margin-top:8px;padding:13px;border:0;border-radius:9px;background:#128c4b;color:white;font:inherit;font-weight:700;cursor:pointer}@media(max-width:600px){.whatsapp-float{right:16px;bottom:16px}.wa-dialog{right:16px;bottom:85px;padding:20px}}
</style>
