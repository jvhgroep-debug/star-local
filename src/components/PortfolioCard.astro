---
interface Props {
  name: string;
  type: string;
  summary: string;
  href: string;
  image?: string;
  imageAlt?: string;
  viewProject: string;
}

const { name, type, summary, href, image, imageAlt = '', viewProject } = Astro.props;
---

<article class="portfolio-card card">
  {image && (
    <div class="portfolio-card-image">
      <img src={image} alt={imageAlt} width="600" height="375" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="card-body">
    <p class="portfolio-type">{type}</p>
    <h3><a href={href}>{name}</a></h3>
    <p>{summary}</p>
    <a href={href} class="card-link">{viewProject}</a>
  </div>
</article>

<style>
  .portfolio-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--transition), border-color var(--transition);
  }

  .portfolio-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
  }

  .portfolio-card-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-elevated);
  }

  .portfolio-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portfolio-type {
    color: var(--gold);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }

  h3 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  p {
    color: var(--text-muted);
    margin: 0 0 1rem;
    line-height: 1.65;
    flex: 1;
  }

  .card-link {
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }
</style>
