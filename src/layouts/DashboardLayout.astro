---
import SeoHead from '../components/SeoHead.astro';
import '../styles/global.css';
import '../styles/builder.css';
import '../styles/dashboard.css';
import '../styles/editor.css';
import '../styles/auth.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  userEmail?: string | null;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  noindex = true,
  userEmail = null,
} = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <SeoHead
      locale="nl"
      {title}
      {description}
      canonicalPath={canonical}
      {noindex}
    />
  </head>
  <body class="dashboard-page-body">
    <a href="#dashboard-main" class="skip-link">Ga naar dashboard</a>
    <header class="dashboard-page-header">
      <div class="container dashboard-page-header__inner">
        <a href="/" class="dashboard-page-brand" aria-label="Star Local home">
          <span>Star Local</span>
        </a>
        <div class="dashboard-page-header__actions">
          {userEmail ? <span class="dashboard-page-user">{userEmail}</span> : null}
          <a href="/logout/" class="dashboard-page-back">Uitloggen</a>
        </div>
      </div>
    </header>
    <main id="dashboard-main" class="dashboard-page-main">
      <slot />
    </main>
    <footer class="dashboard-page-footer">
      <div class="container">
        <p>Star Local Website Builder Beta</p>
      </div>
    </footer>
  </body>
</html>
