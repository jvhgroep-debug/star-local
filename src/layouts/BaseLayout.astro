---
import type { Locale } from '../i18n/config';
import { localeLabels } from '../i18n/config';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import LangPreference from '../components/LangPreference.astro';
import StagingBanner from '../components/StagingBanner.astro';
import Hero from '../components/Hero.astro';
import type { HeroProps } from '../components/hero.types';
import { useTranslations } from '../i18n';
import '../styles/global.css';

interface LayoutProps {
  locale: Locale;
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  fullWidth?: boolean;
  /** Star Local Hero v1 — rendered automatically when provided. */
  hero?: HeroProps;
}

const {
  locale,
  title,
  description,
  canonical = Astro.url.pathname,
  image,
  schema,
  noindex = false,
  fullWidth = false,
  hero,
} = Astro.props as LayoutProps;

const dict = useTranslations(locale);
const layoutFullWidth = fullWidth || !!hero;
---

<!doctype html>
<html lang={localeLabels[locale].htmlLang}>
  <head>
    <SeoHead
      locale={locale}
      title={title}
      description={description ?? dict.meta.defaultDescription}
      canonicalPath={canonical}
      image={image}
      schema={schema}
      noindex={noindex}
    />
    <LangPreference />
  </head>
  <body>
    <StagingBanner />
    <a href="#main-content" class="skip-link">{dict.skipLink}</a>
    <Header locale={locale} />
    <main id="main-content" class:list={['main-content', { 'main-content--full': layoutFullWidth }]}>
      {hero && <Hero {...hero} />}
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppButton />
  </body>
</html>

<style>
  .main-content {
    min-height: 60vh;
    padding: 0 0 2rem;
  }

  .main-content:not(.main-content--full) > :global(.container:first-child),
  .main-content:not(.main-content--full) > :global(section:not(.star-hero) > .container) {
    padding-top: 2rem;
  }
</style>
