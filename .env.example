# Star Local — lokale ontwikkeling (kopieer naar .env)
# NOOIT committen. Productie: Cloudflare Dashboard → Secrets.

# Resend (verplicht voor e-mail in productie)
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=Star Local <noreply@starlocal.nl>
CONTACT_TO_EMAIL=info@starlocal.nl

# Optioneel — admin notificaties (goedkeuring/publicatie)
ADMIN_NOTIFICATION_EMAIL=admin@starlocal.nl

# Optioneel — expliciete base URL's (anders afgeleid van request)
APP_BASE_URL=http://localhost:4327
DASHBOARD_BASE_URL=http://localhost:4327
